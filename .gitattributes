# 此刻编辑器的行为由同目录 .editorconfig 负责（两份内容必须一致）。
* text=auto eol=lf

stalker_toolkit.py text eol=crlf
toolkit_plugins.py text eol=crlf
toolkit_textio.py text eol=crlf
