__pycache__/
*.pyc
temp/
cross_validate_out/
# 一次性重构快照 + PyInstaller 产物：内含源码副本，避免全局搜索命中旧版本
backup/
builds/

# 导出日志目录保留，但不提交日志内容
logs/*
!logs/.gitkeep

# 大体积运行依赖，不在 Git 仓库中
ffmpeg.exe
ffprobe.exe

# 用户配置文件
user.ltx

# 插件目录本身保留（由 plugins/.gitkeep 占位），但**所有插件源码都不入库**：
#   nlc_sqfs.py          —— NLC 闭源插件，不在仓库发布；
#   engine_utf8_patch.py —— 实验性内部测试件（引擎 UTF-8 补丁），需要更多模组样本。
# 推论：干净克隆里 plugins/ 是空的。因此凡是"复制 plugins/ 里的真实插件文件来做断言"
# 的地方，文件不存在时必须记 **SKIP（带 reason）**，绝不能记 FAIL —— 范式见
# run_ci.py 里 plugins.nlc_sqfs 的处理（"闭源插件；不在仓库里时按 SKIP 处理"）。
plugins/*
!plugins/.gitkeep

# Qt 试点的冻结包构建产物（由 build_qt_pilot.py 生成，可复跑，不入库）
qt_pilot_dist/
qt_pilot_build/
